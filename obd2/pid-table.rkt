#lang racket/base

;; The SAE J1979 Mode 01 service PID table, ported from the Python
;; python-OBD library (0.7.3) and frozen as Racket data.  Each entry:
;;   (pid <number> "<NAME>" <data-bytes> (quote <decode-kind>))
;; <data-bytes> is the response payload length after the mode and PID
;; echo bytes; <decode-kind> names the decoder in decode.rkt.

(require racket/contract "pid.rkt")

(provide (contract-out
          [mode-01-pids (listof pid?)]
          [pid-for (-> exact-nonnegative-integer? (or/c pid? #f))]))

(define mode-01-pids
  (list
    (pid #x00 "PIDS_A" 4 'supported-pids)
    (pid #x01 "STATUS" 4 'status)
    (pid #x02 "FREEZE_DTC" 2 'freeze-dtc)
    (pid #x03 "FUEL_STATUS" 2 'fuel-status)
    (pid #x04 "ENGINE_LOAD" 1 'percent)
    (pid #x05 "COOLANT_TEMP" 1 'temp)
    (pid #x06 "SHORT_FUEL_TRIM_1" 1 'percent-centered)
    (pid #x07 "LONG_FUEL_TRIM_1" 1 'percent-centered)
